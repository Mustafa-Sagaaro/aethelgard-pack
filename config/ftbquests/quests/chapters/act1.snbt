		{
			description: [
				"Aethelgard was a kingdom once. Its first king bound the &5Abyssal Sovereign&r beyond the End and locked the door with six &dPlanar Relics&r, each guarded by a Warden."
				""
				"The Wardens have gone feral. The Seal is cracking. Someone has to take the relics back, open the door on purpose - and finish what the old king could not."
				""
				"That someone is your party. This book tracks progress for your &ewhole team&r: one of you finishing a task finishes it for everyone, and every member can claim every reward."
			]
			icon: "ftbquests:book"
			id: "AAA52F860649A08B"
			rewards: [
				{ id: "25B6A6B5B0102E7C", type: "item", item: "minecraft:cooked_beef", count: 16 }
